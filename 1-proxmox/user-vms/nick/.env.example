# Copy to .env next to docker-compose.yaml on the VM (/home/nick/work/.env).
# .env is git-ignored repo-wide (see .gitignore) - never commit real values.
#
# Values come from .github/instructions/secrets.yml:
#   AIRVPN_USERNAME       <- airvpn_user       (shared with the cluster - same AirVPN account)
#   AIRVPN_PASSWORD       <- airvpn_password    (shared with the cluster - same AirVPN account)
#   CLOUDFLARE_TUNNEL_TOKEN <- Nick's own existing Cloudflare tunnel token, not the cluster's

AIRVPN_USERNAME=<AIRVPN_USERNAME>
AIRVPN_PASSWORD=<AIRVPN_PASSWORD>
CLOUDFLARE_TUNNEL_TOKEN=<CLOUDFLARE_TUNNEL_TOKEN>
