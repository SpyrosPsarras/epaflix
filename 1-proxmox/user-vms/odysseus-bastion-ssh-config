# odysseus-bastion (VMID 1043 / 192.168.10.43) — Odysseus execution sandbox.
#
# Reachable DIRECTLY on the LAN (no jumpbox hop, unlike the user VMs). Merge
# into ~/.ssh/config. The maintainer workstation key (~/.ssh/id_ed25519) is
# already in the bastion's authorized_keys.
Host bastion odysseus-bastion
    HostName 192.168.10.43
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
