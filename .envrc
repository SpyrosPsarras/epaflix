# direnv: point this repo's shells at the homelab-only kubeconfig (#856).
#
# Measured limitation, recorded rather than hidden: direnv is not installed on
# this workstation, and a direnv hook never fires in a non-interactive shell -
# which is exactly where tool- and agent-emitted kubectl runs happen. So this
# file is the convenience half, a ~/.zshenv prefix-match export is the
# non-interactive half, and .github/hooks/check-kube-context.sh is the half
# that fails closed. `--context epaflix` on the command itself stays mandatory.
export KUBECONFIG="${PWD}/.kube/epaflix.kubeconfig"
[ -f "${KUBECONFIG}" ] || echo "KUBECONFIG points at a missing file - run ./.github/hooks/install-kubeconfig-epaflix.sh"
