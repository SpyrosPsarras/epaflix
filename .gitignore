secrets.yml
# Glob form, not `.history/`: a directory-level ignore prunes the whole
# subtree before git ever evaluates the negations below, so `!.history/*.md`
# would be silently dead (git can't re-include a file whose parent dir is
# excluded). Keep this as `.history/*` or the negations stop working again.
.history/*
.torrent-cache
*.log
!.history/*.md
!.history/*.sh
raid-migration
.claude/
# Babysitter (.a5c) — best-practice (BEST-PRACTICES.md): track institutional
# knowledge (.a5c/processes/, .a5c/project-profile.json/.md) by NOT ignoring it;
# ignore only noisy/large/sensitive artifacts. Cannot use a blanket `.a5c/`
# because git can't re-include children of a wholly-excluded directory.
.a5c/node_modules/
.a5c/runs/
.a5c/logs/
.a5c/cache/
.a5c/inputs/
.a5c/package-lock.json
.a5c/creds.env
.a5c/creds.env.tmp.*

# Sensitive data - database dumps, backups, research extracts with credentials
2-k3s/08.servarr/_backups/postgres-dumps/
2-k3s/08.servarr/_backups/sqlite-zips/
2-k3s/08.servarr/_backups/postgres-schemas-*/
2-k3s/08.servarr/research/app-configs.xml
2-k3s/08.servarr/research/truenas-configs.txt
2-k3s/08.servarr/research/truenas-ix-apps-full.txt
*.sql
*.sql.gz
*.zip

# Local cache from kustomize+helm pull (per-Application 2-k3s/0X.*/charts/)
charts/

# SOPS plaintext drafts — never commit. Always encrypt to *.enc.yaml first.
*-plaintext.yaml
*.plaintext.yaml
# Glob form, not `.a5c/processes/`: same trap as .history above - a
# directory-level ignore prunes the subtree before negations are evaluated,
# so a negation can't re-include a file whose parent dir is excluded. The 11
# already-tracked process definitions below need explicit per-file negations
# to stay reachable; new scratch files under this directory stay ignored.
.a5c/processes/*
!.a5c/processes/argocd-selfmanage-reconcile.inputs.json
!.a5c/processes/argocd-selfmanage-reconcile.js
!.a5c/processes/argocd-selfmanage-reconcile.mermaid.md
!.a5c/processes/filebrowser-prune-flip.inputs.json
!.a5c/processes/filebrowser-prune-flip.js
!.a5c/processes/filebrowser-prune-flip.mermaid.md
!.a5c/processes/renovate-self-update-triage.inputs.json
!.a5c/processes/renovate-self-update-triage.js
!.a5c/processes/traefik-prune-flip.inputs.json
!.a5c/processes/traefik-prune-flip.js
!.a5c/processes/traefik-prune-flip.mermaid.md

# Superpowers subagent-driven-development scratch (ledger, briefs, review packages).
# Per-plan workspaces under .superpowers/sdd/<plan>/ — the git history is the record.
.superpowers/

# Compose .env files hold runtime secrets (AirVPN account password, Cloudflare
# tunnel tokens) for the user-VM stacks. Never commit these.
.env
*.env
!*.env.example

# Playwright MCP scratch - browser snapshots, which can capture account pages.
.playwright-mcp/
