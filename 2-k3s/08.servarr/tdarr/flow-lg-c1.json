{
  "_id": "lg-c1-compat",
  "name": "LG C1 compatibility",
  "priority": 0,
  "isUiLocked": false,
  "flowPlugins": [
    {
      "id": "input",
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 0
      },
      "inputsDB": {}
    },
    {
      "id": "audio",
      "name": "Check for DTS Audio",
      "sourceRepo": "Community",
      "pluginName": "checkAudioCodec",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 100
      },
      "inputsDB": {
        "codec": "dts"
      }
    },
    {
      "id": "scout",
      "name": "Begin DTS Stream Selection",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "position": {
        "x": -280,
        "y": 200
      },
      "inputsDB": {}
    },
    {
      "id": "mark_dts",
      "name": "Mark DTS Streams in Temporary Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandRemoveStreamByProperty",
      "version": "1.0.0",
      "position": {
        "x": -280,
        "y": 300
      },
      "inputsDB": {
        "codecType": "audio",
        "propertyToCheck": "codec_name",
        "valuesToRemove": "dts",
        "condition": "equals"
      }
    },
    {
      "id": "remember_dts",
      "name": "Save DTS Stream Arguments",
      "sourceRepo": "Community",
      "pluginName": "setFlowVariable",
      "version": "1.0.0",
      "position": {
        "x": -280,
        "y": 400
      },
      "inputsDB": {
        "variable": "dtsArgs",
        "value": "{{#args.variables.ffmpegCommand.streams}}{{#removed}} -c:{{index}} eac3 -b:{{index}} 640k{{/removed}}{{/args.variables.ffmpegCommand.streams}}"
      }
    },
    {
      "id": "hdr",
      "name": "Check HDR Type",
      "sourceRepo": "Local",
      "pluginName": "checkHDRType",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 500
      },
      "inputsDB": {}
    },
    {
      "id": "profile",
      "name": "Check DoVi Profile",
      "sourceRepo": "Local",
      "pluginName": "checkDoViProfile",
      "version": "1.0.0",
      "position": {
        "x": 300,
        "y": 600
      },
      "inputsDB": {}
    },
    {
      "id": "mkv",
      "name": "Check for MKV",
      "sourceRepo": "Community",
      "pluginName": "checkFileExtension",
      "version": "1.0.0",
      "position": {
        "x": 300,
        "y": 700
      },
      "inputsDB": {
        "extensions": "mkv"
      }
    },
    {
      "id": "review",
      "name": "Require Review for Unsupported Dolby Vision",
      "sourceRepo": "Community",
      "pluginName": "requireReview",
      "version": "1.0.0",
      "position": {
        "x": 610,
        "y": 700
      },
      "inputsDB": {}
    },
    {
      "id": "has_dts",
      "name": "Check for DTS Audio",
      "sourceRepo": "Community",
      "pluginName": "checkAudioCodec",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 800
      },
      "inputsDB": {
        "codec": "dts"
      }
    },
    {
      "id": "begin_dts",
      "name": "Begin DTS Conversion",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 900
      },
      "inputsDB": {}
    },
    {
      "id": "begin_strip",
      "name": "Begin Dolby Vision Strip",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "position": {
        "x": 300,
        "y": 900
      },
      "inputsDB": {}
    },
    {
      "id": "dts_args",
      "name": "Convert DTS and Copy Other Streams",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "position": {
        "x": 0,
        "y": 1000
      },
      "inputsDB": {
        "outputArguments": "-c:v copy -c:s copy {{{args.variables.user.dtsArgs}}}"
      }
    },
    {
      "id": "strip_args",
      "name": "Strip Dolby Vision and Convert Any DTS",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "position": {
        "x": 300,
        "y": 1000
      },
      "inputsDB": {
        "outputArguments": "-c:v copy -c:s copy {{{args.variables.user.dtsArgs}}} -bsf:v:0 dovi_rpu=strip=1"
      }
    },
    {
      "id": "execute",
      "name": "Execute FFmpeg",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1100
      },
      "inputsDB": {}
    },
    {
      "id": "known_duration",
      "name": "Require Original Duration",
      "sourceRepo": "Community",
      "pluginName": "checkFlowVariable",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1200
      },
      "inputsDB": {
        "variable": "{{{args.originalLibraryFile.ffProbeData.format.duration}}}",
        "condition": "!=",
        "value": ",0,0.000000,N/A"
      }
    },
    {
      "id": "ratio",
      "name": "Compare File Duration Within 1%",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1300
      },
      "inputsDB": {
        "greaterThan": "99",
        "lessThan": "101"
      }
    },
    {
      "id": "bad_duration",
      "name": "Fail on Missing or Changed Duration",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "position": {
        "x": -170,
        "y": 1400
      },
      "inputsDB": {}
    },
    {
      "id": "health",
      "name": "Run Quick Health Check",
      "sourceRepo": "Community",
      "pluginName": "runHealthCheck",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1400
      },
      "inputsDB": {
        "type": "quick",
        "gpuAcceleration": "none"
      }
    },
    {
      "id": "replace",
      "name": "Replace Original File",
      "sourceRepo": "Community",
      "pluginName": "replaceOriginalFile",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1500
      },
      "inputsDB": {}
    },
    {
      "id": "movie",
      "name": "Check if Movie Library",
      "sourceRepo": "Community",
      "pluginName": "checkFlowVariable",
      "version": "1.0.0",
      "position": {
        "x": 150,
        "y": 1600
      },
      "inputsDB": {
        "variable": "{{{args.librarySettings._id}}}",
        "condition": "==",
        "value": "movies"
      }
    },
    {
      "id": "radarr",
      "name": "Notify Radarr",
      "sourceRepo": "Community",
      "pluginName": "notifyRadarrOrSonarr",
      "version": "3.0.0",
      "position": {
        "x": 0,
        "y": 1700
      },
      "inputsDB": {
        "arr": "radarr",
        "arr_host": "http://127.0.0.1:18268/radarr",
        "unmonitor_after_refresh": "false"
      }
    },
    {
      "id": "sonarr",
      "name": "Notify Sonarr",
      "sourceRepo": "Community",
      "pluginName": "notifyRadarrOrSonarr",
      "version": "3.0.0",
      "position": {
        "x": 300,
        "y": 1700
      },
      "inputsDB": {
        "arr": "sonarr",
        "arr_host": "http://127.0.0.1:18268/sonarr",
        "unmonitor_after_refresh": "false"
      }
    }
  ],
