+// codexClientTemplatePrefix is the provider scope that OpenCode-style clients
+// prepend to Codex model IDs (e.g. "codex/gpt-6-astra"). Only this prefix maps
+// back to the official Codex templates; other provider prefixes do not.
+const codexClientTemplatePrefix = "codex/"
+
+// codexClientTemplateID returns the template slug for a model ID, stripping the
+// known Codex provider prefix. Unprefixed IDs are returned unchanged.
+func codexClientTemplateID(id string) string {
+	return strings.TrimPrefix(id, codexClientTemplatePrefix)
