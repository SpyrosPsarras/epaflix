-- Reconcile the CLIProxyAPI config values that git must own. See #861.
--
-- CLIProxyAPI keeps its whole config.yaml as one text row in config_store, and
-- none of these has an environment variable, so without this they are live-only
-- database state that a rebuild loses.
--
-- The wanted auth-dir is inlined, not a psql variable: psql does NOT
-- interpolate :'var' inside a dollar-quoted DO block. It is a constant and not
-- a secret.
--
-- Both are single-line, single-occurrence YAML keys, verified against the live
-- row before this was written, so an anchored regexp_replace is safe and needs
-- no YAML parser - which is the point. The first version of this shelled out to
-- pip at pod start and failed twice over: no writable HOME under the non-root
-- securityContext from #862, and psycopg2-binary publishes no musl wheels.
--
-- Idempotent: re-running changes nothing once the values match.
--
--   allow-remote  the internal hostname is useless without it. Every
--                 non-localhost caller is refused regardless of key.
--   auth-dir      must sit on the mounted emptyDir. It pointed at the pre-#867
--                 spool inside the image WORKDIR, which #862 then made
--                 read-only, so writing a provider token there would fail.
--   request-log   the ONLY source of request/response payloads. stdout carries
--                 just the gin access line, so Loki can never answer "what was
--                 actually sent" - #1007.
--   logs-max-
--   total-size-mb bounds those payload files. Mandatory, not cosmetic: one file
--                 per request on a 512Mi emptyDir under a 1Gi
--                 ephemeral-storage limit, and the shipped default is 0 =
--                 unlimited.
--
-- api-keys is deliberately NOT handled here. It is a list, not a line, and the
-- owner may rotate it through the management UI. It is git-durable as
-- `omp-api-key` in cliproxy-secrets.enc.yaml and named in the README as a
-- required value - the documented-exception route #861 allows.

\set ON_ERROR_STOP on

DO $$
DECLARE
  n integer;
BEGIN
  IF to_regclass('public.config_store') IS NULL THEN
    RAISE NOTICE 'config_store does not exist yet - first boot, the proxy seeds it';
    RETURN;
  END IF;

  SELECT count(*) INTO n FROM public.config_store WHERE id = 'config';
  IF n = 0 THEN
    RAISE NOTICE 'no config row yet - first boot, the proxy seeds it';
    RETURN;
  END IF;

  UPDATE public.config_store
     SET content = regexp_replace(
                     regexp_replace(
                       content,
                       '^(\s*)allow-remote:[ \t]*false[ \t]*$',
                       '\1allow-remote: true',
                       'n'),
                     '^auth-dir:[ \t]*.*$',
                     'auth-dir: "/var/lib/cliproxy/pgstore/auths"',
                     'n'),
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'reconciled';
END $$;

-- Register the LAN Ollama on TrueNAS as an openai-compatibility upstream, so one
-- endpoint serves both the Claude account and the local models. Append-only and
-- idempotent: openai-compatibility is a top-level key that the seeded config does
-- not define, and YAML does not care about top-level key order, so appending is
-- safe and needs no YAML parser.
--
-- The api-key is a placeholder. Ollama does not authenticate, and the field is
-- required by the schema, so this is deliberately not a secret and belongs in git.
--
-- Model names carry a colon (qwen3.5:9b), which is awkward in a client model
-- string, so each gets a colon-free alias.
DO $$
DECLARE
  c text;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^openai-compatibility:', 'n')) THEN
    RAISE NOTICE 'openai-compatibility already present - leaving it alone';
    RETURN;
  END IF;

  UPDATE public.config_store
     SET content = rtrim(c, E' \n') || E'\n' || $ollama$
openai-compatibility:
  - name: "ollama"
    base-url: "http://192.168.10.200:30068/v1"
    api-key-entries:
      - api-key: "ollama-no-auth-required"
    models:
      - name: "qwen3.5:9b"
        alias: "ollama-qwen3.5-9b"
        display-name: "Qwen 3.5 9B (Ollama)"
      - name: "gemma4:12b-it-qat"
        alias: "ollama-gemma4-12b"
        display-name: "Gemma 4 12B IT QAT (Ollama)"
      - name: "gemma4:e4b"
        alias: "ollama-gemma4-e4b"
        display-name: "Gemma 4 E4B (Ollama)"
      - name: "lfm2.5:8b"
        alias: "ollama-lfm2.5-8b"
        display-name: "LFM 2.5 8B (Ollama)"
      - name: "aya-expanse:8b"
        alias: "ollama-aya-expanse-8b"
        display-name: "Aya Expanse 8B (Ollama)"
$ollama$,
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'openai-compatibility: ollama appended';
END $$;

-- Enable the pi-bridge plugin (#858). Three edits inside the seeded `plugins:`
-- block, which ships disabled with `dir: "plugins"` and `configs: {}`.
--
-- Line-anchored replacements, same reasoning as allow-remote above: each of
-- these keys occurs exactly ONCE at this indentation in the live config, which
-- was checked before this was written. That is an assumption the management UI
-- could break by re-serialising the file, so a duplicate count raises instead
-- of mangling a config it no longer understands.
--
-- `dir` must point at the plugins emptyDir. The default is relative to the
-- image WORKDIR, which #862 made read-only.
--
-- No `store.version` on purpose: the pinned version lives in exactly one place,
-- fetch-pi-bridge.sh, and with a single .so present the host loads that one.
-- `allow_all_api_keys` keeps quota readable by the same client key used for
-- model calls - the plugin's whole point - and never exposes the management key.
DO $$
DECLARE
  c text;
  n integer;
  plugin_cfg constant text := E'    pi-bridge:\n      enabled: true\n      priority: 3\n      allow_all_api_keys: true';
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  SELECT count(*) INTO n FROM regexp_matches(c, '^plugins:[ \t]*$', 'n');
  IF n <> 1 THEN
    RAISE EXCEPTION 'expected exactly one top-level plugins: key, found %', n;
  END IF;

  SELECT count(*) INTO n FROM regexp_matches(c, '^  (enabled|dir|configs):', 'n');
  IF n > 3 THEN
    RAISE EXCEPTION 'plugins block keys are no longer unique at this indentation (% matches) - reconcile by hand', n;
  END IF;

  c := regexp_replace(c, '^  enabled:[ \t]*false[ \t]*$', '  enabled: true', 'n');
  c := regexp_replace(c, '^  dir:[ \t]*"plugins"[ \t]*$', '  dir: "/CLIProxyAPI/plugins"', 'n');

  -- `configs:` is `{}` on a freshly seeded row and a mapping once anything has
  -- been configured through the UI. Handle both; adding the entry first keeps
  -- the replacement a single anchored line either way.
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*pi-bridge:[ \t]*$', 'n')) THEN
    IF EXISTS (SELECT 1 FROM regexp_matches(c, '^  configs:[ \t]*\{\}[ \t]*$', 'n')) THEN
      c := regexp_replace(c, '^  configs:[ \t]*\{\}[ \t]*$', E'  configs:\n' || plugin_cfg, 'n');
    ELSIF EXISTS (SELECT 1 FROM regexp_matches(c, '^  configs:[ \t]*$', 'n')) THEN
      c := regexp_replace(c, '^  configs:[ \t]*$', E'  configs:\n' || plugin_cfg, 'n');
    ELSE
      RAISE EXCEPTION 'plugins.configs is neither {} nor a mapping - reconcile by hand';
    END IF;
  END IF;

  UPDATE public.config_store
     SET content = c,
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'plugins: pi-bridge reconciled';
END $$;

-- Request payload logging (#1007). `request-log: true` makes the proxy write one
-- file per call under WRITABLE_PATH/logs containing the request body, the
-- response body, both header sets and the upstream API request/response - the
-- only place that content exists. Fetch one by the request ID that the stdout
-- access line already prints:
--
--   GET /v0/management/request-log-by-id/<id>
--
-- That endpoint is NOT gated on logging-to-file (internal/api/handlers/management
-- /logs.go GetRequestLogByID checks only the log directory), which is why this
-- deliberately leaves `logging-to-file` at false. Setting that would call
-- log.SetOutput(logWriter) and take the access lines OFF stdout, so promtail and
-- Loki would go dark and we would trade 31 days of searchable history for a
-- 10Mi file on an emptyDir that dies with the pod.
--
-- UPSERT, not replace: unlike allow-remote and auth-dir, `request-log` is absent
-- from the seeded config - not false, ABSENT - so a pure regexp_replace is a
-- silent no-op. Appending a top-level key after the openai-compatibility block
-- above is valid YAML, the dedent closes that block.
--
-- logs-max-total-size-mb drives the cleaner in internal/logging/log_dir_cleaner
-- .go: a 60s ticker that deletes the oldest *.log until the directory is back
-- under the cap. It runs even with logging-to-file false, so it is what keeps
-- per-request files from filling ephemeral storage. 0 disables it entirely.
--
-- 256, MEASURED not guessed (#1011). One /v1/messages file is ~1.1MB and the
-- largest seen was 2.9MB, because each one carries the whole system prompt plus
-- the conversation history - so the first attempt at 64 held only ~55 requests,
-- about 20-30 minutes of an active session. 256MB is ~230 requests. It still
-- fits the budget: 256 logs + ~10 management SPA + a small pgstore spool against
-- the `work` emptyDir's 512Mi sizeLimit, and the container's 1Gi
-- ephemeral-storage limit with tmp at 64Mi and plugins at ~10MB. Raising this
-- further means raising both of those too, so check them first.
DO $$
DECLARE
  c       text;
  want    record;
  pattern text;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  FOR want IN
    SELECT * FROM (VALUES
      ('request-log',            'true'),
      ('logs-max-total-size-mb', '256')
    ) AS t(key, value)
  LOOP
    -- Both are top-level keys at column 0, so no leading \s* - that would also
    -- match a nested key of the same name and edit the wrong line.
    pattern := '^' || want.key || ':[ \t]*.*$';
    IF EXISTS (SELECT 1 FROM regexp_matches(c, pattern, 'n')) THEN
      c := regexp_replace(c, pattern, want.key || ': ' || want.value, 'n');
    ELSE
      c := rtrim(c, E' \n') || E'\n' || want.key || ': ' || want.value || E'\n';
    END IF;
  END LOOP;

  UPDATE public.config_store
     SET content = c, updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'request payload logging reconciled: request-log true, logs-max-total-size-mb 256';
END $$;

-- Prove it, and fail the initContainer if either value is not what git wants.
DO $$
DECLARE
  c text;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  -- The 'n' flag is load-bearing. The bare ~ operator anchors ^ and $ to the
  -- whole string, not to line boundaries, so without it this can never match a
  -- middle line and the check fails on a config that was just corrected.
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*allow-remote:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'allow-remote is still not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^auth-dir:[ \t]*"/var/lib/cliproxy/pgstore/auths"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'auth-dir is not /var/lib/cliproxy/pgstore/auths';
  END IF;

  IF substring(c from 'plugins:\s*\n\s*enabled:[ \t]*(\w+)') <> 'true' THEN
    RAISE EXCEPTION 'plugins.enabled is not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^  dir:[ \t]*"/CLIProxyAPI/plugins"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'plugins.dir is not /CLIProxyAPI/plugins';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*pi-bridge:[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'plugins.configs.pi-bridge is missing';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^request-log:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'request-log is not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^logs-max-total-size-mb:[ \t]*256[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'logs-max-total-size-mb is not 256 after reconcile';
  END IF;
  -- Guard the pairing, not just the values: request-log with logging-to-file
  -- true would move the access lines off stdout and blind Loki (#1006 territory).
  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^logging-to-file:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'logging-to-file is true - that takes the access log off stdout and blinds Loki; see #1007';
  END IF;

  RAISE NOTICE 'verified: allow-remote true, auth-dir /var/lib/cliproxy/pgstore/auths, pi-bridge enabled, request-log true capped at 256MB, logging-to-file false';
END $$;
