-- Reconcile the CLIProxyAPI config values that git must own. See #861.
--
-- CLIProxyAPI keeps its whole config.yaml as one text row in config_store, and
-- none of these has an environment variable, so without this they are live-only
-- database state that a rebuild loses.
--
-- The wanted auth-dir is inlined, not a psql variable: psql does NOT
-- interpolate :'var' inside a dollar-quoted DO block. It is a constant and not
-- a secret.
--
-- Both are single-line, single-occurrence YAML keys, verified against the live
-- row before this was written, so an anchored regexp_replace is safe and needs
-- no YAML parser - which is the point. The first version of this shelled out to
-- pip at pod start and failed twice over: no writable HOME under the non-root
-- securityContext from #862, and psycopg2-binary publishes no musl wheels.
--
-- Idempotent: re-running changes nothing once the values match.
--
--   allow-remote  the internal hostname is useless without it. Every
--                 non-localhost caller is refused regardless of key.
--   auth-dir      must sit on the mounted emptyDir. It pointed at the pre-#867
--                 spool inside the image WORKDIR, which #862 then made
--                 read-only, so writing a provider token there would fail.
--   request-log   the ONLY source of request/response payloads. stdout carries
--                 just the gin access line, so Loki can never answer "what was
--                 actually sent" - #1007.
--   logs-max-
--   total-size-mb bounds those payload files. Mandatory, not cosmetic: one file
--                 per request on a 512Mi emptyDir under a 1Gi
--                 ephemeral-storage limit, and the shipped default is 0 =
--                 unlimited.
--
-- api-keys is deliberately NOT handled here. It is a list, not a line, and the
-- owner may rotate it through the management UI. It is git-durable as
-- `omp-api-key` in cliproxy-secrets.enc.yaml and named in the README as a
-- required value - the documented-exception route #861 allows.

\set ON_ERROR_STOP on

DO $$
DECLARE
  n integer;
BEGIN
  IF to_regclass('public.config_store') IS NULL THEN
    RAISE NOTICE 'config_store does not exist yet - first boot, the proxy seeds it';
    RETURN;
  END IF;

  SELECT count(*) INTO n FROM public.config_store WHERE id = 'config';
  IF n = 0 THEN
    RAISE NOTICE 'no config row yet - first boot, the proxy seeds it';
    RETURN;
  END IF;

  UPDATE public.config_store
     SET content = regexp_replace(
                     regexp_replace(
                       content,
                       '^(\s*)allow-remote:[ \t]*false[ \t]*$',
                       '\1allow-remote: true',
                       'n'),
                     '^auth-dir:[ \t]*.*$',
                     'auth-dir: "/var/lib/cliproxy/pgstore/auths"',
                     'n'),
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'reconciled';
END $$;

-- Register the LAN Ollama on TrueNAS as an openai-compatibility upstream, so one
-- endpoint serves both the Claude account and the local models. Append-only and
-- idempotent: openai-compatibility is a top-level key that the seeded config does
-- not define, and YAML does not care about top-level key order, so appending is
-- safe and needs no YAML parser.
--
-- The api-key is a placeholder. Ollama does not authenticate, and the field is
-- required by the schema, so this is deliberately not a secret and belongs in git.
--
-- Model names carry a colon (qwen3.5:9b), which is awkward in a client model
-- string, so each gets a colon-free alias.
--
-- The last entry is the lingarr failover alias: aya-expanse:8b ALSO answers as
-- or-minimax-m3:free, the same alias the openrouter provider below serves. The
-- openrouter entry carries priority 10, this provider stays at the default 0,
-- and credential selection only considers the highest healthy priority tier -
-- so minimax serves the alias until an openrouter cooldown (its 429 daily cap),
-- then aya takes over until the cooldown lifts. This deliberate cross-provider
-- alias collision is the failover, not a naming accident.
DO $$
DECLARE
  c text;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^openai-compatibility:', 'n')) THEN
    RAISE NOTICE 'openai-compatibility already present - leaving it alone';
    RETURN;
  END IF;

  UPDATE public.config_store
     SET content = rtrim(c, E' \n') || E'\n' || $ollama$
openai-compatibility:
  - name: "ollama"
    base-url: "http://192.168.10.200:30068/v1"
    api-key-entries:
      - api-key: "ollama-no-auth-required"
    models:
      - name: "qwen3.5:9b"
        alias: "ollama-qwen3.5-9b"
        display-name: "Qwen 3.5 9B (Ollama)"
      - name: "gemma4:12b-it-qat"
        alias: "ollama-gemma4-12b"
        display-name: "Gemma 4 12B IT QAT (Ollama)"
      - name: "gemma4:e4b"
        alias: "ollama-gemma4-e4b"
        display-name: "Gemma 4 E4B (Ollama)"
      - name: "lfm2.5:8b"
        alias: "ollama-lfm2.5-8b"
        display-name: "LFM 2.5 8B (Ollama)"
      - name: "aya-expanse:8b"
        alias: "ollama-aya-expanse-8b"
        display-name: "Aya Expanse 8B (Ollama)"
      - name: "aya-expanse:8b"
        alias: "or-minimax-m3:free"
        display-name: "Aya Expanse 8B (Ollama, lingarr failover)"
$ollama$,
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'openai-compatibility: ollama appended';
END $$;

-- Register OpenRouter as a second openai-compatibility upstream.
--
-- Why here and not the management UI: same #861 reason as everything above. A
-- provider added through the panel is a row in the live config only, and the
-- next rebuild eats it. The Copilot session log (.history/2026-08-24) records
-- that failure mode in full.
--
-- This does NOT reuse the ollama block above. That one is guarded on the
-- top-level `openai-compatibility:` key being absent, which stopped being true
-- the moment it ran once, so it is now a permanent no-op and cannot carry a
-- second provider. This block instead splices an item INTO the existing list,
-- immediately after the `openai-compatibility:` line. Inserting at the head of
-- the list keeps the edit a single anchored line no matter what follows it -
-- the same trick the `configs:` insert below uses, and it stays correct now
-- that `request-log:` and friends are appended at column 0 after the list.
--
-- Idempotency is on `- name: "openrouter"` rather than on a top-level key,
-- because the top-level key is now always present.
--
-- Model choice: only models the proxy does NOT already serve from a
-- subscription account. No anthropic, openai, x-ai or moonshotai entries - we
-- hold flat-rate accounts for those, and routing them here would bill per token
-- for capacity already paid for. Every alias carries an `or-` prefix, the same
-- convention the ollama entries use, so an OpenRouter model can never collide
-- with a native account's model ID no matter what OpenRouter renames upstream.
--
-- minimax-m3:free exists because lingarr (08.servarr) pins it as its only
-- translation model via reconcile-ai-provider.sql. It rides OpenRouter's shared
-- free-tier daily cap, so 429 bursts through this alias are expected, not an
-- outage. The entry was first added through the management UI and is now
-- git-owned here; the UI copy carried a wrong display-name until reconciled.
-- Its alias is the one deliberate exception to colon-free naming: the :free
-- suffix mirrors OpenRouter's own slug and the entry has served under it.
-- priority 10 keeps this provider the preferred credential for the alias; the
-- ollama provider serves the same alias at the default priority 0 as lingarr's
-- failover target, and the selector only ever mixes tiers when the higher one
-- is cooling down.
--
-- Unlike the ollama api-key above, this one IS a secret. It arrives as
-- OPENROUTER_API_KEY on the initContainer from cliproxy-secrets, and is read
-- with a psql backtick \set - see the deployment.yaml comment for why not
-- --set=. Note that it lands in the config_store row in cleartext: that row is
-- how CLIProxyAPI stores every provider credential, so this is the existing
-- posture, not a new exposure.

-- \o /dev/null around this is load-bearing, not tidiness. set_config() RETURNS
-- the value it set, so a bare SELECT prints the API key on stdout - which for
-- this initContainer is the pod log, which promtail ships to Loki on a 31-day
-- retention. This repo has already had to purge credential-shaped lines out of
-- that index four times (#634, #702, #824, #911). Caught by running it.
--
-- The value cannot go into a DO block instead: psql does not interpolate
-- :'var' inside a dollar-quoted body, which is the same constraint recorded at
-- the top of this file for the auth-dir replacement.
\set openrouter_key `printenv OPENROUTER_API_KEY`
\o /dev/null
SELECT set_config('cliproxy.openrouter_key', :'openrouter_key', false);
\o

-- Validate the key BEFORE any table guard. Every other block in this file may
-- legitimately return early on first boot, when the proxy has not seeded
-- config_store yet. A missing secret is not a first-boot condition, it is a
-- broken deployment, and returning early on it would let the pod start with no
-- OpenRouter credential and report success. This block therefore touches no
-- table at all, so an unset key fails the initContainer on an empty database
-- exactly as it does on a seeded one.
DO $$
DECLARE
  k text := coalesce(current_setting('cliproxy.openrouter_key', true), '');
BEGIN
  -- An empty value would write `api-key: ""` and the provider would list its
  -- models and then 401 on every call - a failure that looks like a broken
  -- model, not like a missing secret.
  IF k = '' THEN
    RAISE EXCEPTION 'OPENROUTER_API_KEY is empty - the cliproxy-secrets key did not reach the initContainer';
  END IF;

  -- Shape check doubles as YAML injection defence: the key is interpolated into
  -- a double-quoted scalar below, so anything carrying a quote, backslash or
  -- newline must not get that far.
  IF k !~ '^sk-or-v1-[A-Za-z0-9._-]+$' THEN
    RAISE EXCEPTION 'OPENROUTER_API_KEY is not shaped like an OpenRouter key (sk-or-v1-...)';
  END IF;
END $$;

DO $$
DECLARE
  c     text;
  orig  text;
  k     text;
  n     integer;
  entry text;
BEGIN
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;
  orig := c;

  -- Already validated by the block above; re-read rather than re-check.
  k := current_setting('cliproxy.openrouter_key');

  -- Rotation path. Presence of the provider is NOT proof that its credential is
  -- the one git holds: rotating openrouter-api-key in cliproxy-secrets.enc.yaml
  -- would otherwise leave the superseded key live in the config row forever,
  -- because this block would see `- name: "openrouter"` and return. So when the
  -- provider exists, reconcile its api-key line to the wanted value instead of
  -- skipping. Anchored on the sk-or-v1- prefix, which is unique to this
  -- provider - the ollama entry above carries a literal placeholder - so this
  -- cannot touch another provider's credential.
  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^  - name: "openrouter"[ \t]*$', 'n')) THEN
    c := regexp_replace(c,
                        '^      - api-key: "sk-or-v1-[A-Za-z0-9._-]*"[ \t]*$',
                        '      - api-key: "' || k || '"',
                        'n');
    IF c IS DISTINCT FROM orig THEN
      UPDATE public.config_store SET content = c, updated_at = now() WHERE id = 'config';
      RAISE NOTICE 'openai-compatibility: openrouter api-key reconciled to the value git holds';
    ELSE
      RAISE NOTICE 'openai-compatibility: openrouter already present and current';
    END IF;
    RETURN;
  END IF;

  -- Exactly one splice target, for the same reason the plugins block below
  -- counts its keys: a management UI that re-serialises the file could produce
  -- a second list, and editing the first of two silently configures a provider
  -- nothing reads.
  SELECT count(*) INTO n FROM regexp_matches(c, '^openai-compatibility:[ \t]*$', 'n');
  IF n <> 1 THEN
    RAISE EXCEPTION 'expected exactly one top-level openai-compatibility: key, found %', n;
  END IF;

  entry := replace($openrouter$  - name: "openrouter"
    priority: 10
    base-url: "https://openrouter.ai/api/v1"
    api-key-entries:
      - api-key: "__OPENROUTER_API_KEY__"
    models:
      - name: "z-ai/glm-5.3-flash"
        alias: "or-glm-5.3-flash"
        display-name: "GLM 5.3 Flash (OpenRouter)"
      - name: "z-ai/glm-5.3"
        alias: "or-glm-5.3"
        display-name: "GLM 5.3 (OpenRouter)"
      - name: "google/gemini-3.7-flash"
        alias: "or-gemini-3.7-flash"
        display-name: "Gemini 3.7 Flash (OpenRouter)"
      - name: "deepseek/deepseek-v4-flash-0731"
        alias: "or-deepseek-v4-flash"
        display-name: "DeepSeek V4 Flash (OpenRouter)"
      - name: "deepseek/deepseek-v4-pro-0813"
        alias: "or-deepseek-v4-pro"
        display-name: "DeepSeek V4 Pro (OpenRouter)"
      - name: "qwen/qwen3.8-max"
        alias: "or-qwen3.8-max"
        display-name: "Qwen3.8 Max (OpenRouter)"
      - name: "qwen/qwen3.8-27b"
        alias: "or-qwen3.8-27b"
        display-name: "Qwen3.8 27B (OpenRouter)"
      - name: "minimax/minimax-m3"
        alias: "or-minimax-m3"
        display-name: "MiniMax M3 (OpenRouter)"
      - name: "minimax/minimax-m3:free"
        alias: "or-minimax-m3:free"
        display-name: "MiniMax M3 Free (OpenRouter)"$openrouter$, '__OPENROUTER_API_KEY__', k);

  c := regexp_replace(c,
                      '^openai-compatibility:[ \t]*$',
                      'openai-compatibility:' || E'\n' || entry,
                      'n');

  UPDATE public.config_store
     SET content = c,
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'openai-compatibility: openrouter spliced in';
END $$;

-- Enable the plugins (#858 pi-bridge, plus the GitHub Copilot provider). Edits
-- inside the seeded `plugins:` block, which ships disabled with
-- `dir: "plugins"` and `configs: {}`.
--
-- Line-anchored replacements, same reasoning as allow-remote above: each of
-- these keys occurs exactly ONCE at this indentation in the live config, which
-- was checked before this was written. That is an assumption the management UI
-- could break by re-serialising the file, so a duplicate count raises instead
-- of mangling a config it no longer understands.
--
-- `dir` must point at the plugins emptyDir. The default is relative to the
-- image WORKDIR, which #862 made read-only.
--
-- No `store.version` on purpose: a plugin version is pinned in exactly one
-- place, its fetch-plugin.sh arguments in deployment.yaml, and the host loads
-- the .so that is present.
-- `allow_all_api_keys` keeps quota readable by the same client key used for
-- model calls - the plugin's whole point - and never exposes the management key.
--
-- The Copilot entry carries only the two non-default values. Every other field
-- the plugin's install doc lists (github_client_id, the three base URLs, the
-- three timeouts) is already that exact value in the plugin's own
-- DefaultConfig(), so repeating them here would only be a second copy to keep in
-- sync. `excluded_model_prefixes` keeps Copilot's Claude and Gemini re-offerings
-- from colliding with the native Anthropic and Gemini OAuth accounts, which own
-- those model IDs here; drop a line to let Copilot serve them too.
DO $$
DECLARE
  c text;
  n integer;
  want record;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  SELECT count(*) INTO n FROM regexp_matches(c, '^plugins:[ \t]*$', 'n');
  IF n <> 1 THEN
    RAISE EXCEPTION 'expected exactly one top-level plugins: key, found %', n;
  END IF;

  SELECT count(*) INTO n FROM regexp_matches(c, '^  (enabled|dir|configs):', 'n');
  IF n > 3 THEN
    RAISE EXCEPTION 'plugins block keys are no longer unique at this indentation (% matches) - reconcile by hand', n;
  END IF;

  c := regexp_replace(c, '^  enabled:[ \t]*false[ \t]*$', '  enabled: true', 'n');
  c := regexp_replace(c, '^  dir:[ \t]*"plugins"[ \t]*$', '  dir: "/CLIProxyAPI/plugins"', 'n');

  -- `configs:` is `{}` on a freshly seeded row and a mapping once anything has
  -- been configured through the UI. Handle both; inserting straight after the
  -- `configs:` line keeps the replacement a single anchored line either way, and
  -- keeps working for the second entry because that line survives the first.
  FOR want IN
    SELECT * FROM (VALUES
      ('pi-bridge',
       E'    pi-bridge:\n      enabled: true\n      priority: 3\n      allow_all_api_keys: true'),
      ('cliproxyapi-copilot',
       E'    cliproxyapi-copilot:\n      enabled: true\n      priority: 100\n      excluded_model_prefixes:\n        - "claude-"\n        - "gemini-"')
    ) AS t(id, cfg)
  LOOP
    CONTINUE WHEN EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*' || want.id || ':[ \t]*$', 'n'));
    IF EXISTS (SELECT 1 FROM regexp_matches(c, '^  configs:[ \t]*\{\}[ \t]*$', 'n')) THEN
      c := regexp_replace(c, '^  configs:[ \t]*\{\}[ \t]*$', E'  configs:\n' || want.cfg, 'n');
    ELSIF EXISTS (SELECT 1 FROM regexp_matches(c, '^  configs:[ \t]*$', 'n')) THEN
      c := regexp_replace(c, '^  configs:[ \t]*$', E'  configs:\n' || want.cfg, 'n');
    ELSE
      RAISE EXCEPTION 'plugins.configs is neither {} nor a mapping - reconcile by hand';
    END IF;
  END LOOP;

  UPDATE public.config_store
     SET content = c,
         updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'plugins: pi-bridge and cliproxyapi-copilot reconciled';
END $$;

-- Request payload logging (#1007). `request-log: true` makes the proxy write one
-- file per call under WRITABLE_PATH/logs containing the request body, the
-- response body, both header sets and the upstream API request/response - the
-- only place that content exists. Fetch one by the request ID that the stdout
-- access line already prints:
--
--   GET /v0/management/request-log-by-id/<id>
--
-- That endpoint is NOT gated on logging-to-file (internal/api/handlers/management
-- /logs.go GetRequestLogByID checks only the log directory), which is why this
-- deliberately leaves `logging-to-file` at false. Setting that would call
-- log.SetOutput(logWriter) and take the access lines OFF stdout, so promtail and
-- Loki would go dark and we would trade 31 days of searchable history for a
-- 10Mi file on an emptyDir that dies with the pod.
--
-- UPSERT, not replace: unlike allow-remote and auth-dir, `request-log` is absent
-- from the seeded config - not false, ABSENT - so a pure regexp_replace is a
-- silent no-op. Appending a top-level key after the openai-compatibility block
-- above is valid YAML, the dedent closes that block.
--
-- logs-max-total-size-mb drives the cleaner in internal/logging/log_dir_cleaner
-- .go: a 60s ticker that deletes the oldest *.log until the directory is back
-- under the cap. It runs even with logging-to-file false, so it is what keeps
-- per-request files from filling ephemeral storage. 0 disables it entirely.
--
-- 256, MEASURED not guessed (#1011). One /v1/messages file is ~1.1MB and the
-- largest seen was 2.9MB, because each one carries the whole system prompt plus
-- the conversation history - so the first attempt at 64 held only ~55 requests,
-- about 20-30 minutes of an active session. 256MB is ~230 requests. It still
-- fits the budget: 256 logs + ~10 management SPA + a small pgstore spool against
-- the `work` emptyDir's 512Mi sizeLimit, and the container's 1Gi
-- ephemeral-storage limit with tmp at 64Mi and plugins declared at 128Mi
-- (~47MiB of that is actually used by the two .so files). Raising this
-- further means raising both of those too, so check them first.
DO $$
DECLARE
  c       text;
  want    record;
  pattern text;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  FOR want IN
    SELECT * FROM (VALUES
      ('request-log',            'true'),
      ('logs-max-total-size-mb', '256'),
      -- Feeds CPAMP (cpamanager/deployment.yaml). This defaults to FALSE in
      -- internal/config/config_load.go, and redisqueue enqueues nothing while it
      -- is false, so every CPAMP panel would sit empty with no error anywhere -
      -- the failure mode is "no data", which is exactly the direction this
      -- repo's verifications have historically failed in. Unlike request-log
      -- this key IS present in the seeded config - `usage-statistics-enabled:
      -- false` at line 126 of the v7.2.140 image's own config.example.yaml - so
      -- it takes the regexp_replace branch below, not the append branch. Both
      -- were exercised: reconcile run twice against a postgres:16 seeded from
      -- that file lands on exactly one occurrence, value true.
      --
      -- CPAMP can also set this itself during its setup wizard. Git sets it
      -- instead: a value only live in the app's own DB is reverted by the next
      -- rebuild, and this pod restores config from Postgres on every start.
      ('usage-statistics-enabled', 'true')
    ) AS t(key, value)
  LOOP
    -- Both are top-level keys at column 0, so no leading \s* - that would also
    -- match a nested key of the same name and edit the wrong line.
    pattern := '^' || want.key || ':[ \t]*.*$';
    IF EXISTS (SELECT 1 FROM regexp_matches(c, pattern, 'n')) THEN
      c := regexp_replace(c, pattern, want.key || ': ' || want.value, 'n');
    ELSE
      c := rtrim(c, E' \n') || E'\n' || want.key || ': ' || want.value || E'\n';
    END IF;
  END LOOP;

  UPDATE public.config_store
     SET content = c, updated_at = now()
   WHERE id = 'config';

  RAISE NOTICE 'request payload logging reconciled: request-log true, logs-max-total-size-mb 256, usage-statistics-enabled true';
END $$;

-- Prove it, and fail the initContainer if either value is not what git wants.
DO $$
DECLARE
  c   text;
  n   integer;
BEGIN
  -- First boot: the proxy has not seeded the table yet. Without this the block
  -- raises undefined_table and CrashLoops the initContainer on an empty
  -- Postgres - the guard in the first block only ever protected that block.
  IF to_regclass('public.config_store') IS NULL THEN RETURN; END IF;
  SELECT content INTO c FROM public.config_store WHERE id = 'config';
  IF c IS NULL THEN RETURN; END IF;

  -- The 'n' flag is load-bearing. The bare ~ operator anchors ^ and $ to the
  -- whole string, not to line boundaries, so without it this can never match a
  -- middle line and the check fails on a config that was just corrected.
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*allow-remote:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'allow-remote is still not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^auth-dir:[ \t]*"/var/lib/cliproxy/pgstore/auths"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'auth-dir is not /var/lib/cliproxy/pgstore/auths';
  END IF;

  IF substring(c from 'plugins:\s*\n\s*enabled:[ \t]*(\w+)') <> 'true' THEN
    RAISE EXCEPTION 'plugins.enabled is not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^  dir:[ \t]*"/CLIProxyAPI/plugins"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'plugins.dir is not /CLIProxyAPI/plugins';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*pi-bridge:[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'plugins.configs.pi-bridge is missing';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^\s*cliproxyapi-copilot:[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'plugins.configs.cliproxyapi-copilot is missing';
  END IF;

  -- Both openai-compatibility providers, and one alias from each, so a splice
  -- that lands the entry but mangles the model list still fails the container.
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^  - name: "ollama"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'openai-compatibility: the ollama provider is gone';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^  - name: "openrouter"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'openai-compatibility: the openrouter provider is missing after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^        alias: "or-glm-5.3-flash"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'openai-compatibility: openrouter model list did not survive the splice';
  END IF;
  -- lingarr's pinned translation model; its absence would not fail the proxy
  -- itself, which is exactly why it gets its own line here. EXACTLY TWO
  -- providers must serve the alias: openrouter (priority 10) as primary, the
  -- ollama provider as cooldown fallback. Counting matches instead of
  -- anchoring a display-name keeps this immune to cosmetic UI renames.
  SELECT count(*) INTO n
    FROM regexp_matches(c, '^        alias: "or-minimax-m3:free"[ \t]*$', 'gn');
  IF n <> 2 THEN
    RAISE EXCEPTION 'openai-compatibility: or-minimax-m3:free must be served by exactly two providers (openrouter + ollama failover), found %', n;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^      - name: "minimax/minimax-m3:free"[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'openai-compatibility: the openrouter minimax-m3:free model is missing';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^    priority: 10[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'openai-compatibility: the openrouter provider lost its priority: 10 failover marking';
  END IF;
  -- An empty api-key would list models and 401 on every call. Catch it here
  -- too, not just at write time, in case a later edit blanks it.
  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^      - api-key: ""[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'an openai-compatibility api-key is empty';
  END IF;
  -- The stored credential must be the one git holds, not merely non-empty -
  -- otherwise a rotation that failed to apply passes verification. position()
  -- rather than a regex because the key is interpolated, and `.` in a key would
  -- be a wildcard that quietly matches a DIFFERENT key. Compares, never prints.
  IF position('      - api-key: "' || current_setting('cliproxy.openrouter_key') || '"' in c) = 0 THEN
    RAISE EXCEPTION 'the openrouter api-key in the config row is not the value git holds';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^request-log:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'request-log is not true after reconcile';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^logs-max-total-size-mb:[ \t]*256[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'logs-max-total-size-mb is not 256 after reconcile';
  END IF;
  -- Top-level key at column 0, so no leading \s* - a nested key of the same
  -- name must not satisfy this check.
  IF NOT EXISTS (SELECT 1 FROM regexp_matches(c, '^usage-statistics-enabled:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'usage-statistics-enabled is not true after reconcile - CPAMP would show an empty dashboard with no error';
  END IF;
  -- Guard the pairing, not just the values: request-log with logging-to-file
  -- true would move the access lines off stdout and blind Loki (#1006 territory).
  IF EXISTS (SELECT 1 FROM regexp_matches(c, '^logging-to-file:[ \t]*true[ \t]*$', 'n')) THEN
    RAISE EXCEPTION 'logging-to-file is true - that takes the access log off stdout and blinds Loki; see #1007';
  END IF;

  RAISE NOTICE 'verified: allow-remote true, auth-dir /var/lib/cliproxy/pgstore/auths, pi-bridge and cliproxyapi-copilot enabled, openai-compatibility ollama + openrouter present, request-log true capped at 256MB, logging-to-file false, usage-statistics-enabled true';
END $$;
