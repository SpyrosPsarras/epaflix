#!/usr/bin/env bash
# Load an SSH private key stored as a KeePass vault attachment into the
# running ssh-agent. The key never touches disk.
# Usage: ssh-key-from-vault <entry-path> <attachment-filename>
set -euo pipefail
set -a
. /etc/t3code/t3code.env
set +a
entry=${1:?usage: ssh-key-from-vault <entry-path> <attachment-filename>}
file=${2:?usage: ssh-key-from-vault <entry-path> <attachment-filename>}
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-/run/user/$(id -u)/openssh_agent}"
exec 3>"$KEEPASS_DB.lock"
flock 3
/opt/keepass-mcp/bin/python - "$entry" "$file" <<'PY' | ssh-add -
import os
import sys

from pykeepass import PyKeePass

entry_path, filename = sys.argv[1], sys.argv[2]
kp = PyKeePass(os.environ["KEEPASS_DB"], password=os.environ["KEEPASS_PASSPHRASE"])
needle = "/" + entry_path.strip("/")
def entry_path_str(e):
    return "/" + "/".join(p if isinstance(p, str) and p else "" for p in (e.path or []))
matches = [e for e in kp.entries if entry_path_str(e) == needle]
if not matches:
    sys.exit(f"no entry at '{entry_path}'")
att = next((a for a in matches[0].attachments if a.filename == filename), None)
if att is None:
    sys.exit(f"no attachment '{filename}' on '{entry_path}'")
sys.stdout.buffer.write(att.data)
PY
