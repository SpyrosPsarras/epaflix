# Pinned versions for the t3code guest. Renovate bumps every line; update.sh
# applies them on the guest (daily timer, and provision.sh at bootstrap).
T3_VERSION=0.0.38              # renovate: datasource=npm depName=t3
CLAUDE_CODE_VERSION=2.1.263    # renovate: datasource=npm depName=@anthropic-ai/claude-code
OPENCODE_VERSION=1.18.29       # renovate: datasource=npm depName=opencode-ai
HELM_VERSION=3.21.4            # renovate: datasource=github-releases depName=helm/helm
KUSTOMIZE_VERSION=5.8.1        # renovate: datasource=github-releases depName=kubernetes-sigs/kustomize
ARGOCD_VERSION=3.5.2           # renovate: datasource=github-releases depName=argoproj/argo-cd
SOPS_VERSION=3.13.3            # renovate: datasource=github-releases depName=getsops/sops
