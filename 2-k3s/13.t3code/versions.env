# Cluster tooling pins for the guest. Renovate updates these for update.sh.
# Shared npm CLI pins and their lock are in env/tools/package.json and
# package-lock.json, maintained by Renovate's native npm manager.
HELM_VERSION=3.22.0            # renovate: datasource=github-releases depName=helm/helm
KUSTOMIZE_VERSION=5.8.1        # renovate: datasource=github-releases depName=kubernetes-sigs/kustomize
ARGOCD_VERSION=3.5.3           # renovate: datasource=github-releases depName=argoproj/argo-cd
SOPS_VERSION=3.13.3            # renovate: datasource=github-releases depName=getsops/sops
