pkgname=t3code-v2
pkgver=0.0.44
pkgrel=1
pkgdesc='T3 Code orchestrator v2 client, separate from t3code-nightly'
arch=('x86_64')
url='https://github.com/pingdotgg/t3code'
license=('MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2' 'gtk3' 'libcups' 'libdrm' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss')
options=('!strip')
source=('client.tar.gz' 't3code-v2' 't3code-v2.desktop')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -d "$pkgdir/opt/t3code-v2"
  cp -a "$srcdir/client/." "$pkgdir/opt/t3code-v2/"
  rm -f "$pkgdir/opt/t3code-v2/resources/package-type" "$pkgdir/opt/t3code-v2/resources/app-update.yml"
  install -Dm755 "$srcdir/t3code-v2" "$pkgdir/usr/bin/t3code-v2"
  install -Dm644 "$srcdir/t3code-v2.desktop" "$pkgdir/usr/share/applications/t3code-v2.desktop"
}
