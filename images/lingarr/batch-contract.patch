+    private static readonly TimeSpan StaleRequestAfter = TimeSpan.FromMinutes(60);
+    internal static TimeSpan DuplicatePollInterval = TimeSpan.FromSeconds(15);
+
+    private async Task AwaitDuplicateRequestAsync(
+        IQueryable<TranslationRequest> matchingRequests,
+        CancellationToken dbCancellationToken,
+        CancellationToken pollCancellationToken)
+    {
+        while (true)
+        {
+            var existing = await matchingRequests
+                .Where(r => r.Status == TranslationStatus.Pending || r.Status == TranslationStatus.InProgress)
+                .OrderByDescending(r => r.CreatedAt)
+                .ThenByDescending(r => r.Id)
+                .Select(r => new { r.Id, r.Status, r.CreatedAt })
+                .FirstOrDefaultAsync(dbCancellationToken);
+            if (existing == null)
+            {
+                return;
+            }
+
+            var lastActivity = await _dbContext.TranslationRequestLines
+                .Where(l => l.TranslationRequestId == existing.Id)
+                .OrderByDescending(l => l.CreatedAt)
+                .Select(l => (DateTimeOffset?)l.CreatedAt)
+                .FirstOrDefaultAsync(dbCancellationToken);
+            if ((lastActivity ?? existing.CreatedAt) < DateTimeOffset.UtcNow - StaleRequestAfter)
+            {
+                _logger.LogWarning(
+                    "Content-translation request {Id} is {Status} but shows no line activity for {Hours:0}h - marking it Interrupted so the next request starts fresh.",
+                    existing.Id, existing.Status, StaleRequestAfter.TotalHours);
+                var now = DateTimeOffset.UtcNow;
+                await _dbContext.TranslationRequests
+                    .Where(r => r.Id == existing.Id)
+                    .ExecuteUpdateAsync(s => s
+                        .SetProperty(r => r.Status, TranslationStatus.Interrupted)
+                        .SetProperty(r => r.ErrorMessage, $"stale: no line activity for {StaleRequestAfter.TotalHours:0}h")
+                        .SetProperty(r => r.CompletedAt, now)
+                        .SetProperty(r => r.UpdatedAt, now), CancellationToken.None);
+                await _eventService.LogEvent(existing.Id, TranslationStatus.Interrupted, "stale: no line activity");
+                await UpdateActiveCount();
+                continue;
+            }
+            await Task.Delay(DuplicatePollInterval, pollCancellationToken);
+        }
+    }
+
+    /// <summary>
+    /// The caller re-POSTs content after a failed attempt as a new request
+    /// that would start again from line 1. On a quota-limited provider every
+    /// retry then re-spends the budget on the same opening batches and long
+    /// files never finish. Seed the new request with the newest failed,
+    /// interrupted or cancelled attempt's lines whose position and source
+    /// text still match and whose target is neither empty nor the source
+    /// copied through; the batch loop skips items that already carry a
+    /// translation. The carried lines are stored on the new request as well,
+    /// so the next retry and the completed-reuse count both see them.
+    /// </summary>
+    private async Task CarryOverPriorLinesAsync(
+        TranslationRequest translationRequest,
+        List<SubtitleItem> subtitleItems,
+        CancellationToken cancellationToken)
+    {
+        var priorId = await _dbContext.TranslationRequests
+            .Where(r => r.Id != translationRequest.Id
+                     && r.MediaId == translationRequest.MediaId
+                     && r.MediaType == translationRequest.MediaType
+                     && r.Title == translationRequest.Title
+                     && r.SourceLanguage == translationRequest.SourceLanguage
+                     && r.TargetLanguage == translationRequest.TargetLanguage
+                     && (r.Status == TranslationStatus.Failed
+                         || r.Status == TranslationStatus.Interrupted
+                         || r.Status == TranslationStatus.Cancelled))
+            .OrderByDescending(r => r.Id)
+            .Select(r => (int?)r.Id)
+            .FirstOrDefaultAsync(cancellationToken);
+        if (priorId == null)
+        {
+            return;
+        }
+
+        var priorByPosition = (await _dbContext.TranslationRequestLines
+                .Where(l => l.TranslationRequestId == priorId)
+                .OrderBy(l => l.Id)
+                .Select(l => new { l.Position, l.Source, l.Target, l.Service })
+                .ToListAsync(cancellationToken))
+            .GroupBy(l => l.Position)
+            .ToDictionary(g => g.Key, g => g.Last());
+
+        var carried = new List<TranslatedLineData>();
+        foreach (var item in subtitleItems)
+        {
+            var source = item.Lines[0];
+            if (!priorByPosition.TryGetValue(item.Position, out var prior)
+                || prior.Source != source
+                || (!string.IsNullOrWhiteSpace(source)
+                    && (string.IsNullOrWhiteSpace(prior.Target) || prior.Target == source)))
+            {
+                continue;
+            }
+            item.TranslatedLines = [prior.Target];
+            carried.Add(new TranslatedLineData
+            {
+                Position = item.Position,
+                Source = prior.Source,
+                Target = prior.Target,
+                Service = prior.Service
+            });
+        }
+        if (carried.Count == 0)
+        {
+            return;
+        }
+
+        await _progressService.EmitLines(translationRequest, carried);
+        _logger.LogInformation(
+            "Request {Id} carries over {Carried}/{Total} translated lines from request {PriorId}.",
+            translationRequest.Id, carried.Count, subtitleItems.Count, priorId);
+    }
