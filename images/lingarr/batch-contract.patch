+    /// <summary>
+    /// A structured batch response is only accepted when it covers exactly the requested
+    /// positions: nothing missing, nothing extra, no duplicates, and no empty line where the
+    /// source line had content. Anything else is a TranslationParseException so the caller
+    /// retries the same structured request instead of silently keeping original lines.
+    /// </summary>
+    private static void ValidateBatchCoverage(
+        List<BatchSubtitleItem> subtitleBatch,
+        List<StructuredBatchResponse> translatedItems)
+    {
+        var requested = subtitleBatch.Select(item => item.Position).ToHashSet();
+        var returned = translatedItems.Select(item => item.Position).ToList();
+        var returnedSet = returned.ToHashSet();
+
+        var missing = requested.Except(returnedSet).Order().ToList();
+        var extra = returnedSet.Except(requested).Order().ToList();
+        var duplicates = returned.GroupBy(position => position)
+            .Where(group => group.Count() > 1)
+            .Select(group => group.Key)
+            .Order()
+            .ToList();
+        var empty = translatedItems
+            .Where(item => string.IsNullOrWhiteSpace(item.Line)
+                           && subtitleBatch.Any(source => source.Position == item.Position
+                                                          && !string.IsNullOrWhiteSpace(source.Line)))
+            .Select(item => item.Position)
+            .Distinct()
+            .Order()
+            .ToList();
+
+        if (missing.Count == 0 && extra.Count == 0 && duplicates.Count == 0 && empty.Count == 0)
+        {
+            return;
+        }
+
+        throw new TranslationParseException(
+            $"Structured batch response did not cover the requested positions " +
+            $"(missing: [{string.Join(",", missing)}], extra: [{string.Join(",", extra)}], " +
+            $"duplicate: [{string.Join(",", duplicates)}], empty: [{string.Join(",", empty)}])");
+    }
