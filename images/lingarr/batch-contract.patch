+    /// <summary>
+    /// Finds a reusable translation for the incoming content and either
+    /// delivers its stored lines or waits for the running request to finish:
+    /// a client disconnect is not a cancel (the translation runs detached
+    /// from the request-aborted token), so the caller's retry after its own
+    /// HTTP timeout must converge on the running request instead of starting
+    /// a second one. A completed request is reused by delivering its stored
+    /// lines; a line count mismatch (the source file changed between
+    /// attempts) falls through to a fresh translation.
+    /// A Pending/InProgress request with no line activity for
+    /// <see cref="StaleRequestAfter"/> is a zombie left behind by a restart
+    /// or a crashed run: it is reaped as Interrupted so the next POST starts
+    /// fresh. The threshold must sit above the longest normal silent stretch
+    /// of one batch, not above the whole translation.
+    /// Returns null when nothing is reusable (translate fresh). A client
+    /// disconnect while waiting rethrows: falling through would start a
+    /// second translation of content that is already running.
+    /// </summary>
+    private static readonly TimeSpan StaleRequestAfter = TimeSpan.FromMinutes(60);
+    internal static TimeSpan DuplicatePollInterval = TimeSpan.FromSeconds(15);
+
+    private async Task<BatchTranslatedLine[]?> ReuseOrAwaitExistingAsync(
+        TranslationRequest translationRequest,
+        int expectedLineCount,
+        CancellationToken dbCancellationToken,
+        CancellationToken pollCancellationToken)
+    {
+        var existing = await _dbContext.TranslationRequests
+            .Where(r => r.MediaId == translationRequest.MediaId
+                     && r.MediaType == translationRequest.MediaType
+                     && r.Title == translationRequest.Title
+                     && r.SourceLanguage == translationRequest.SourceLanguage
+                     && r.TargetLanguage == translationRequest.TargetLanguage
+                     && (r.Status == TranslationStatus.Pending
+                         || r.Status == TranslationStatus.InProgress
+                         || r.Status == TranslationStatus.Completed))
+            .OrderByDescending(r => r.Id)
+            .Select(r => new { r.Id, r.Status, r.CreatedAt })
+            .FirstOrDefaultAsync(dbCancellationToken);
+        if (existing == null)
+        {
+            return null;
+        }
+
+        _logger.LogInformation(
+            "Content-translation request for mediaId {MediaId} ({MediaType}) '{Title}' {Src}->{Tgt} reuses request {Id} in status {Status}.",
+            translationRequest.MediaId, translationRequest.MediaType, translationRequest.Title,
+            translationRequest.SourceLanguage, translationRequest.TargetLanguage, existing.Id, existing.Status);
+
+        try
+        {
+            var status = existing.Status;
+            while (status is TranslationStatus.Pending or TranslationStatus.InProgress)
+            {
+                var lastActivity = await _dbContext.TranslationRequestLines
+                    .Where(l => l.TranslationRequestId == existing.Id)
+                    .OrderByDescending(l => l.CreatedAt)
