+using Moq;
+using Xunit;
+
+namespace Lingarr.Server.Tests.Services;
+
+/// <summary>
+/// Tests for the content-translation POST path: a disconnecting client must
+/// not cancel the translation (token decoupling), and a re-POST for content
+/// that is already translating or already translated must converge on the
+/// existing request instead of starting a second translation.
+/// </summary>
+public class TranslationRequestServiceTests
+{
+    static TranslationRequestServiceTests()
+    {
+        // The duplicate poll interval defaults to 15s; the tests drive it at
+        // 1ms so the wait loop is exercised without real sleeping. Only this
+        // test class touches the static.
+        TranslationRequestService.DuplicatePollInterval = TimeSpan.FromMilliseconds(1);
+    }
+
+    private sealed class Harness
+    {
+        public LingarrDbContext DbContext { get; init; } = null!;
+        public SqliteConnection Connection { get; init; } = null!;
+        public Mock<IBatchTranslationService> BatchServiceMock { get; init; } = null!;
+        public TranslationRequestService Service { get; init; } = null!;
+    }
+
+    private static Harness CreateHarness(Func<List<BatchSubtitleItem>, Dictionary<int, string>>? batchTranslate = null)
+    {
+        // SQLite in memory, not the InMemory provider: the service uses
+        // ExecuteUpdateAsync (terminal-state writes), which InMemory refuses.
+        // One open connection keeps the database alive across context
+        // instances (the wait-flip test uses a second context).
+        var connection = new SqliteConnection("DataSource=:memory:");
+        connection.Open();
+        var options = new DbContextOptionsBuilder<LingarrDbContext>()
+            .UseSqlite(connection)
+            .Options;
+        var dbContext = new LingarrDbContext(options);
+        dbContext.Database.EnsureCreated();
+
+        // One mock implementing both interfaces: TranslateContentAsync takes
+        // the batch path only when entry.Service is IBatchTranslationService.
+        var translationServiceMock = new Mock<ITranslationService>();
+        translationServiceMock
+            .Setup(t => t.GetLanguagePair(
+                It.IsAny<string>(),
+                It.IsAny<string>(),
+                It.IsAny<CancellationToken>()))
+            .ReturnsAsync((string source, string target, CancellationToken _) =>
+                new LanguagePair { Source = source, Target = target, Tier = MatchTier.Exact });
+        var batchInterface = translationServiceMock.As<IBatchTranslationService>();
+        if (batchTranslate != null)
+        {
+            batchInterface
+                .Setup(b => b.TranslateBatchAsync(
+                    It.IsAny<List<BatchSubtitleItem>>(),
+                    It.IsAny<string>(),
+                    It.IsAny<string>(),
+                    It.IsAny<CancellationToken>()))
+                .ReturnsAsync((List<BatchSubtitleItem> items, string _, string _, CancellationToken _) =>
+                    batchTranslate(items));
+        }
+
+        var factoryMock = new Mock<ITranslationServiceFactory>();
+        factoryMock
+            .Setup(f => f.CreateTranslationServices(It.IsAny<IReadOnlyList<string>>()))
+            .Returns(new List<TranslationServiceEntry>
+            {
+                new("localai", translationServiceMock.Object, batchInterface.Object)
+            });
+
+        var settingServiceMock = new Mock<ISettingService>();
+        settingServiceMock
+            .Setup(s => s.GetSettings(It.IsAny<IEnumerable<string>>()))
+            .ReturnsAsync(new Dictionary<string, string>
+            {
+                [SettingKeys.Translation.UseBatchTranslation] = "true",
+                [SettingKeys.Translation.ServiceType] = "[\"localai\"]",
+                [SettingKeys.Translation.MaxBatchSize] = "25",
+                [SettingKeys.Translation.StripSubtitleFormatting] = "false",
+                [SettingKeys.Translation.PreserveLineBreaks] = "false"
+            });
+
+        var mediaServiceMock = new Mock<IMediaService>();
+        mediaServiceMock
+            .Setup(m => m.GetMovieIdOrSyncFromRadarrMovieId(It.IsAny<int>()))
+            .ReturnsAsync(7);
+
+        var hubClientsMock = new Mock<IHubClients>();
+        hubClientsMock
+            .Setup(c => c.Group(It.IsAny<string>()))
+            .Returns(new Mock<IClientProxy>().Object);
+        var hubContextMock = new Mock<IHubContext<TranslationRequestsHub>>();
+        hubContextMock
+            .SetupGet(h => h.Clients)
+            .Returns(hubClientsMock.Object);
+
+        var service = new TranslationRequestService(
+            dbContext,
+            new Mock<IBackgroundJobClient>().Object,
+            hubContextMock.Object,
+            factoryMock.Object,
+            new Mock<IProgressService>().Object,
+            new Mock<IStatisticsService>().Object,
+            mediaServiceMock.Object,
+            settingServiceMock.Object,
+            new Mock<ISubtitleService>().Object,
+            new Mock<ITranslationRequestEventService>().Object,
+            NullLogger<TranslationRequestService>.Instance);
+
+        return new Harness
+        {
+            DbContext = dbContext,
+            Connection = connection,
+            BatchServiceMock = batchInterface,
+            Service = service
+        };
+    }
+
+    private static TranslateAbleSubtitleContent Content(int lineCount, string title = "Show · file.srt") => new()
+    {
+        ArrMediaId = 5,
+        MediaType = MediaType.Movie,
+        Title = title,
+        SourceLanguage = "en",
+        TargetLanguage = "el",
+        Lines = Enumerable.Range(1, lineCount)
+            .Select(i => new BatchSubtitleLine { Position = i, Line = $"line {i}" })
+            .ToList()
+    };
+
+    private static TranslationRequest StoredRequest(int id, TranslationStatus status, DateTimeOffset? createdAt = null) => new()
+    {
+        Id = id,
+        MediaId = 7,
+        Title = "Show · file.srt",
+        SourceLanguage = "en",
+        TargetLanguage = "el",
+        MediaType = MediaType.Movie,
+        Status = status,
+        CreatedAt = createdAt ?? DateTimeOffset.UtcNow,
+        UpdatedAt = DateTimeOffset.UtcNow
+    };
+
+    private static void SeedLines(LingarrDbContext db, int requestId, params (int position, string target)[] lines)
+    {
+        foreach (var (position, target) in lines)
+        {
+            db.TranslationRequestLines.Add(new TranslationRequestLine
+            {
+                TranslationRequestId = requestId,
+                Position = position,
+                Source = $"source {position}",
+                Target = target
+            });
+        }
+        db.SaveChanges();
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_ClientDisconnects_TranslationStillCompletes()
+    {
+        // Arrange: the caller's connection is already gone (Bazarr hit its HTTP
+        // timeout). Before the token decoupling this cancelled the request and
+        // marked it Cancelled; now the work must run to completion.
+        var harness = CreateHarness(items => items.ToDictionary(i => i.Position, i => $"μετάφραση {i.Position}"));
+        var disconnected = new CancellationToken(canceled: true);
+
+        // Act
+        var results = await harness.Service.TranslateContentAsync(Content(2), disconnected);
+
+        // Assert
+        Assert.Equal(2, results.Length);
+        Assert.Equal("μετάφραση 1", results[0].Line);
+        var stored = await harness.DbContext.TranslationRequests.SingleAsync();
+        Assert.Equal(TranslationStatus.Completed, stored.Status);
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_CompletedDuplicateWithSameLines_DeliversStoredLines()
+    {
+        // Arrange: a completed request for the same content exists (the first
+        // caller timed out and the detached work finished afterwards). The
+        // retry must be served from the stored lines, not re-translated.
+        var harness = CreateHarness();
+        harness.DbContext.TranslationRequests.Add(StoredRequest(1, TranslationStatus.Completed));
+        SeedLines(harness.DbContext, 1, (1, "η γάτα"), (2, "ο σκύλος"), (3, "το ποντίκι"));
+        harness.DbContext.SaveChanges();
+
+        // Act
+        var results = await harness.Service.TranslateContentAsync(Content(3), CancellationToken.None);
+
+        // Assert: delivered by position from storage; no second request row.
+        Assert.Equal(3, results.Length);
+        Assert.Equal("ο σκύλος", results[1].Line);
+        Assert.Equal(1, await harness.DbContext.TranslationRequests.CountAsync());
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_CompletedDuplicateWithDifferentLines_TranslatesFresh()
+    {
+        // Arrange: the stored request translated a different file version (a
+        // re-downloaded episode). The count mismatch must fall through to a
+        // fresh translation, never deliver mismatched lines.
+        var harness = CreateHarness(items => items.ToDictionary(i => i.Position, i => $"νέο {i.Position}"));
+        harness.DbContext.TranslationRequests.Add(StoredRequest(1, TranslationStatus.Completed));
+        SeedLines(harness.DbContext, 1, (1, "η γάτα"), (2, "ο σκύλος"));
+        harness.DbContext.SaveChanges();
+
+        // Act
+        var results = await harness.Service.TranslateContentAsync(Content(3), CancellationToken.None);
+
+        // Assert: fresh lines, and the fresh attempt is its own request row.
+        Assert.Equal(3, results.Length);
+        Assert.Equal("νέο 1", results[0].Line);
+        Assert.Equal(2, await harness.DbContext.TranslationRequests.CountAsync());
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_RunningDuplicateEventuallyDeliversStoredLines()
+    {
+        // Arrange: the first attempt is still running (detached). The retry
+        // waits; a background completion lets the wait deliver the lines.
+        var harness = CreateHarness();
+        harness.DbContext.TranslationRequests.Add(StoredRequest(1, TranslationStatus.InProgress));
+        SeedLines(harness.DbContext, 1, (1, "η γάτα"), (2, "ο σκύλος"));
+        harness.DbContext.SaveChanges();
+
+        var flip = Task.Run(async () =>
+        {
+            await Task.Delay(50);
+            // A second context on the same connection: the service under test
+            // is polling with its own context instance (not thread-safe).
+            var options = new DbContextOptionsBuilder<LingarrDbContext>()
+                .UseSqlite(harness.Connection)
+                .Options;
+            await using var other = new LingarrDbContext(options);
+            var row = await other.TranslationRequests.SingleAsync(r => r.Id == 1);
+            row.Status = TranslationStatus.Completed;
+            row.CompletedAt = DateTimeOffset.UtcNow;
+            await other.SaveChangesAsync();
+        });
+
+        // Act
+        var results = await harness.Service.TranslateContentAsync(Content(2), CancellationToken.None);
+        await flip;
+
+        // Assert
+        Assert.Equal(2, results.Length);
+        Assert.Equal("η γάτα", results[0].Line);
+        Assert.Equal(1, await harness.DbContext.TranslationRequests.CountAsync());
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_StaleRunningDuplicate_ReapedAndFreshTranslationRuns()
+    {
+        // Arrange: an InProgress row with no line activity for over an hour -
+        // a restart or crash left it behind. The wait must not hang on it:
+        // reap it as Interrupted, then translate fresh in this request.
+        var harness = CreateHarness(items => items.ToDictionary(i => i.Position, i => "φρέσκο"));
+        harness.DbContext.TranslationRequests.Add(
+            StoredRequest(1, TranslationStatus.InProgress, DateTimeOffset.UtcNow.AddHours(-2)));
+        harness.DbContext.SaveChanges();
+
+        // Act
+        var results = await harness.Service.TranslateContentAsync(Content(2), CancellationToken.None);
+
+        // Assert: the zombie is Interrupted and the fresh work completed as a
+        // new row.
+        Assert.Equal(2, results.Length);
+        Assert.Equal("φρέσκο", results[0].Line);
+        var zombie = await GetRowUnchecked(harness, 1);
+        Assert.Equal(TranslationStatus.Interrupted, zombie.Status);
+        Assert.Equal(2, await harness.DbContext.TranslationRequests.CountAsync());
+    }
+
+    [Fact]
+    public async Task TranslateContentAsync_WaitingClientDisconnects_DoesNotStartSecondTranslation()
+    {
+        // Arrange: the running duplicate must never be raced by a fresh
+        // translation. A pre-cancelled parent token simulates the client
+        // hanging up while the waiter polls.
+        var harness = CreateHarness();
+        harness.DbContext.TranslationRequests.Add(StoredRequest(1, TranslationStatus.InProgress));
+        SeedLines(harness.DbContext, 1, (1, "η γάτα"), (2, "ο σκύλος"));
+        harness.DbContext.SaveChanges();
+        var disconnected = new CancellationToken(canceled: true);
+
+        // Act + Assert: the wait rethrows the client's cancel...
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() =>
+            harness.Service.TranslateContentAsync(Content(2), disconnected));
+        // ...and no second request row was created for the content.
+        Assert.Equal(1, await harness.DbContext.TranslationRequests.CountAsync());
+        var stillRunning = await GetRowUnchecked(harness, 1);
+        Assert.Equal(TranslationStatus.InProgress, stillRunning.Status);
+    }
+
+    private static async Task<TranslationRequest> GetRowUnchecked(Harness harness, int id)
+    {
+        // Fresh context: ExecuteUpdateAsync bypasses change tracking, so a
+        // context that already tracks the row would return the stale entity.
+        var options = new DbContextOptionsBuilder<LingarrDbContext>()
+            .UseSqlite(harness.Connection)
+            .Options;
+        await using var other = new LingarrDbContext(options);
+        return await other.TranslationRequests.SingleAsync(r => r.Id == id);
+    }
+}
