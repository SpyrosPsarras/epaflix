+        {
+            sent.AddRange(items.Select(i => i.Position));
+            return items.ToDictionary(i => i.Position, i => "νέο");
+        });
+        harness.DbContext.TranslationRequests.Add(StoredRequest(1, TranslationStatus.Completed));
+        harness.DbContext.TranslationRequestLines.Add(
+            new TranslationRequestLine { TranslationRequestId = 1, Position = 1, Source = "line 1", Target = "παλιό" });
+        harness.DbContext.SaveChanges();
+
+        var results = await harness.Service.TranslateContentAsync(Content(2), CancellationToken.None);
