+                preserveLineBreaks: false,
+                CancellationToken.None));
+
+        // Assert: the only configured service failed, so the batch fails, and no subtitle carries
+        // its source text as a "translation".
+        Assert.Contains("All configured batch translation services failed", exception.Message);
+        Assert.Contains("position 2", exception.InnerException!.Message);
+        Assert.DoesNotContain(subtitles, subtitle => subtitle.TranslatedLines.SequenceEqual(subtitle.Lines));
+    }
