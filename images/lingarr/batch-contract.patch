+
+    private static async Task<TranslationRequest> GetRowUnchecked(Harness harness, int id)
+    {
+        // Fresh context: ExecuteUpdateAsync bypasses change tracking, so a
+        // context that already tracks the row would return the stale entity.
+        var options = new DbContextOptionsBuilder<LingarrDbContext>()
+            .UseSqlite(harness.ConnectionString)
+            .Options;
+        await using var other = new LingarrDbContext(options);
+        return await other.TranslationRequests.SingleAsync(r => r.Id == id);
+    }
